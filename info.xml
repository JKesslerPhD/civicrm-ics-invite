    <url desc="Support">https://github.com/JKesslerPhD/civicrm-ics-invite/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-22</releaseDate>
  <version>1.0.1</version>
  <develStage>stable</develStage>
  <compatibility>
